# CTP2 macOS Dependencies
# Install with: brew bundle
# Or: make deps

# Graphics, input, audio (SDL3 only)
brew "sdl3"
brew "sdl3_mixer"

# Image format support
brew "libtiff"

# Compression
brew "zlib"

# Build system
brew "meson"
brew "ninja"
brew "pkg-config"
brew "ccache"

# Parser generators (code generation)
brew "byacc"
brew "flex"

# Testing framework - header only, but good to document
# doctest is vendored in tests/
