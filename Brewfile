# CTP2 macOS Dependencies
# Install with: brew bundle
# Or: make deps

# Graphics, input, audio (SDL3 is the default backend; for the legacy
# sdl2 backend — meson -Dsdl_backend=sdl2 — install sdl2 + sdl2_mixer instead)
brew "sdl3"
brew "sdl3_mixer"

# Image format support
brew "libtiff"

# Compression
brew "zlib"

# Build system
brew "meson"
brew "ninja"
brew "pkg-config"

# Parser generators (code generation)
brew "byacc"
brew "flex"

# Testing framework - header only, but good to document
# doctest is vendored in tests/
