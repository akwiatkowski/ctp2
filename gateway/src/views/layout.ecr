<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title><%= HTML.escape(@title) %> · ctp2-gateway</title>
<style>
  :root { color-scheme: dark; }
  body { font-family: ui-monospace, Menlo, monospace; background:#14171a; color:#d8dee4; margin:0; }
  nav { background:#1d2228; padding:0.6rem 1rem; border-bottom:1px solid #2c333b; }
  nav a { color:#79b8ff; text-decoration:none; margin-right:1.2rem; }
  nav a:hover { text-decoration:underline; }
  main { padding:1rem 1.5rem; max-width:60rem; }
  table { border-collapse:collapse; margin-top:0.8rem; width:100%; }
  th,td { border:1px solid #2c333b; padding:0.35rem 0.7rem; text-align:left; }
  th { background:#1d2228; }
  a { color:#79b8ff; }
  .ok { color:#7ce38b; } .bad { color:#ff7b72; } .muted { color:#8b949e; }
  .card { background:#1d2228; border:1px solid #2c333b; border-radius:6px; padding:0.8rem 1rem; margin:0.6rem 0; }
  h1 { font-size:1.2rem; }
  code { background:#22272e; padding:0.1rem 0.3rem; border-radius:3px; }
</style>
</head>
<body>
<nav>
  <a href="/">Dashboard</a>
  <a href="/players">Players</a>
  <a href="/healthz">Health</a>
</nav>
<main>
<%= @content %>
</main>
</body>
</html>
